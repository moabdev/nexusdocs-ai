# Application
APP_NAME="NexusDocs AI"
APP_ENV=production
APP_DEBUG=false

# Google Gemini API Key (Required for RAG answers)
GEMINI_API_KEY=

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_VECTOR_SIZE=384

# Qdrant Vector Store
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=nexusdocs

# Streamlit Web
NEXUSDOCS_API_URL=http://api:8000
